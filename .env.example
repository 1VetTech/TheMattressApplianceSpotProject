# Public CSV URL generated by:
# Google Sheets > File > Share > Publish to web
#
# Publish only the PublicWebsiteInventory worksheet as CSV.
PUBLIC_INVENTORY_CSV_URL=https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_PUBLISHED_SHEET_ID/pub?output=csv

# Local destination for generated website inventory data.
OUTPUT_JSON=output/inventory.json
